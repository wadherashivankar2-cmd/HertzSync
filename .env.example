# TrickleSettle Environment Configuration

# Cluster guard (devnet only - any other value refuses to start)
CLUSTER=devnet

# Comma-separated list of DevNet RPC endpoints (at least 2 for failover)
RPC_ENDPOINTS=https://api.devnet.solana.com,https://devnet.helius-rpc.com

# Path to the treasury keypair JSON file
TREASURY_KEYPAIR_PATH=./keys/treasury.json

# Minimum balance in lamports required in treasury before processing batches (0.1 SOL)
TREASURY_MIN_LAMPORTS=100000000

# SQLite database path (single file shared by app and worker)
DB_PATH=./data/trickle.db

# Admin API key for chaos and administrative routes
ADMIN_API_KEY=dev_admin_secret_key_here

# Enable chaos injection endpoints (dev only, disabled in production)
CHAOS_ENABLED=true

# Batching parameters
BATCH_INTERVAL_MS=5000
BATCH_MAX_EVENTS=100
MAX_BATCH_LAMPORTS=1000000000
MAX_EVENT_LAMPORTS=100000000
MAX_ATTEMPTS=5
MEMO_MAX_BYTES=120

# Reconciliation cadence
RECONCILE_INTERVAL_MS=30000

# Circuit breaker parameters
CB_FAILURE_THRESHOLD=3
CB_COOLDOWN_MS=30000
RPC_TIMEOUT_MS=8000

# Rate limiting (per minute per business API key)
RATE_LIMIT_PER_MIN=600

# Graceful shutdown wait time before closing
SHUTDOWN_GRACE_MS=10000

